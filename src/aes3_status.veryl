/// AES3 channel statusのsubframe schedulerへの同期
///
/// 0..183ではstatus mapperのbitを出しながらCRCを更新し、184..191では完了したCRCをLSB firstで出力する。channel A/Bのstatusが同一の構成を前提に、CRC更新は各frameのB subframe受理時に一度だけ行う
import Types::SampleRate;
import Aes3::ChannelMode;

module Aes3ChannelStatusStream (
    clk         : input  clock         ,
    rst         : input  reset         ,
    advance     : input  logic         ,
    frame_index : input  logic      <8>,
    channel_b   : input  logic         ,
    sample_rate : input  SampleRate    ,
    channel_mode: input  ChannelMode   ,
    status_bit  : output logic         ,
    crc         : output logic      <8>,
) {
    var crc_reg: logic<8>;

    assign crc = crc_reg;

    always_comb {
        if frame_index <: 8'd184 {
            status_bit = Aes3::channel_status_bit(frame_index, sample_rate, channel_mode);
        } else if frame_index <: 8'd192 {
            status_bit = crc_reg[frame_index - 8'd184];
        } else {
            status_bit = 0;
        }
    }

    always_ff {
        if_reset {
            crc_reg = 8'hFF;
        } else if advance && channel_b {
            if frame_index <: 8'd184 {
                let status  : logic = Aes3::channel_status_bit(frame_index, sample_rate, channel_mode);
                let feedback: logic = crc_reg[0] ^ status;
                if feedback {
                    crc_reg = (crc_reg >> 1) ^ 8'hB8;
                } else {
                    crc_reg = crc_reg >> 1;
                }
            } else if frame_index == 8'd191 {
                crc_reg = 8'hFF;
            }
        }
    }
}

/// AES3 status streamのCRC更新タイミングを検証
#[test(test_aes3_channel_status_stream)]
module test_aes3_channel_status_stream {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var advance    : logic   ;
    var frame_index: logic<8>;
    var channel_b  : logic   ;
    var status_bit : logic   ;
    var crc        : logic<8>;

    inst dut: Aes3ChannelStatusStream (
        clk         : clk                          ,
        rst         : rst                          ,
        advance     : advance                      ,
        frame_index : frame_index                  ,
        channel_b   : channel_b                    ,
        sample_rate : Types::SampleRate::Fs48000   ,
        channel_mode: Aes3::ChannelMode::TwoChannel,
        status_bit  : status_bit                   ,
        crc         : crc                          ,
    );

    initial {
        advance     = 0;
        frame_index = 0;
        channel_b   = 0;
        rst.assert();
        $assert(status_bit, "AES3 status bit zero must be professional flag");

        frame_index = 8'd0;
        channel_b   = 1;
        advance     = 1;
        clk.next(1);
        advance     = 0;
        frame_index = 8'd184;
        channel_b   = 0;
        $assert(status_bit == crc[0], "AES3 CRC stream must expose CRC LSB first");

        frame_index = 8'd191;
        channel_b   = 1;
        advance     = 1;
        clk.next(1);
        advance = 0;
        $assert(crc == 8'hFF, "AES3 CRC stream must restart at block boundary");
        $finish();
    }
}

/// AES3 status streamのCRCを専用CRC moduleと全184bitで比較
#[test(test_aes3_channel_status_stream_crc)]
module test_aes3_channel_status_stream_crc {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    const SAMPLE_RATE : Types::SampleRate = Types::SampleRate::Fs48000;
    const CHANNEL_MODE: Aes3::ChannelMode = Aes3::ChannelMode::TwoChannel;

    var advance    : logic   ;
    var frame_index: logic<8>;
    var channel_b  : logic   ;
    var stream_crc : logic<8>;

    var crc_start: logic     ;
    var crc_done : logic     ;
    var crc_value: logic<8>  ;
    var status   : logic<184>;

    inst stream: Aes3ChannelStatusStream (
        clk         : clk         ,
        rst         : rst         ,
        advance     : advance     ,
        frame_index : frame_index ,
        channel_b   : channel_b   ,
        sample_rate : SAMPLE_RATE ,
        channel_mode: CHANNEL_MODE,
        status_bit  : _           ,
        crc         : stream_crc  ,
    );

    inst crc: Aes3ChannelStatusCrc (
        clk   : clk      ,
        rst   : rst      ,
        start : crc_start,
        status: status   ,
        busy  : _        ,
        done  : crc_done ,
        crc   : crc_value,
    );

    initial {
        advance     = 0;
        frame_index = 0;
        channel_b   = 0;
        crc_start   = 0;
        status      = 0;
        for i in 0..184 {
            status[i] = Aes3::channel_status_bit(i as 8, SAMPLE_RATE, CHANNEL_MODE);
        }
        rst.assert();

        for i in 0..184 {
            frame_index = i as 8;
            channel_b   = 1;
            advance     = 1;
            clk.next(1);
            advance = 0;
        }

        crc_start = 1;
        clk.next(1);
        crc_start = 0;
        clk.next(184);
        $assert(crc_done, "AES3 reference CRC did not finish");
        $assert(crc_value == stream_crc, "AES3 stream CRC must match the reference CRC");
        $finish();
    }
}
